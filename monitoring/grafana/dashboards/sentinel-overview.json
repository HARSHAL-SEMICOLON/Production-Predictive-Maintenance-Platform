  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Production Telemetry & Inference Health",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 1,
      "title": "API Inference Throughput (RPS)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(sentinel_prediction_requests_total[1m])",
          "legendFormat": "{{model_type}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 2,
      "title": "Inference Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sentinel_prediction_latency_seconds_bucket[1m])) by (le, model_type))",
          "legendFormat": "p95 {{model_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "title": "Critical Maintenance Alerts",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(sentinel_failure_alerts_total{alert_level=\"CRITICAL\"})",
          "legendFormat": "Critical Alerts",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "title": "Predicted Remaining Useful Life (RUL)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sentinel_predicted_rul_cycles",
          "legendFormat": "Engine {{engine_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 20 }, { "color": "red", "value": 35 }] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "title": "Evidently AI Data Drift Score (%)",
      "type": "gauge",
      "targets": [
        {
          "expr": "sentinel_data_drift_score",
          "legendFormat": "Drift Share",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
