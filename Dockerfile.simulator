# Dockerfile for IoT Sensor Simulator
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir requests numpy pandas

COPY src/ingestion/ src/ingestion/
COPY src/config.py src/
COPY src/utils/ src/utils/

CMD ["python", "-m", "src.ingestion.simulator", "--url", "http://api:8000/api/v1/telemetry", "--interval", "1.0"]
